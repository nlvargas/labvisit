DEBUG=true
SECRET_KEY=change-me
DEFAULT_LAB_SLUG=biodata
# sqlite by default; for Neon use the pooled connection string
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
READER_PROVIDER=fake
# seconds the fake reader waits, to see the reading screen
# FAKE_READER_DELAY=6
# READER_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest
# LOG_LEVEL=INFO
JOBS_BACKEND=sync
# browser key restricted to your domains, with the Maps JavaScript API and Places API (New)
# GOOGLE_MAPS_API_KEY=
# server key restricted to Places API (New), to find addresses typed in WhatsApp
# GOOGLE_MAPS_SERVER_KEY=

# WhatsApp Cloud API. "console" prints outgoing messages instead of sending them.
WHATSAPP_BACKEND=console
# WHATSAPP_BACKEND=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# base URL for links sent by WhatsApp; {slug} is the lab subdomain
# LAB_URL_TEMPLATE=https://{slug}.lab.compile.cl
